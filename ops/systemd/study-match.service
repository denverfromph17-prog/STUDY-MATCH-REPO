[Unit]
Description=Study Match PH web application
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/study-match-data

[Service]
Type=simple
User=studymatch
Group=studymatch
WorkingDirectory=/opt/study-match/current
EnvironmentFile=/etc/study-match/study-match.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/study-match-data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
